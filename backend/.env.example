NASA_MAP_KEY=votre_cle_nasa_firms
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/firecarbon

# Mode compte de service (production/ONG) : renseigner GEE_SERVICE_ACCOUNT_JSON
GEE_SERVICE_ACCOUNT_JSON=

# Mode authentification personnelle (dev local, sans clé JSON) :
# laisser GEE_SERVICE_ACCOUNT_JSON vide, renseigner seulement GEE_PROJECT_ID,
# et lancer `earthengine authenticate` une fois dans le venv.
GEE_PROJECT_ID=
